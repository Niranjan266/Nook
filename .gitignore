node_modules/
dist/
.env
.env.local
.env.*.local

# Generated by Make-Keys.bat. Real secrets — must never be committed.
MY-KEYS.txt

# The local SQLite database and anything uploaded to it. Never commit either —
# the .db file contains real messages and password hashes.
server/data/
*.db
*.db-journal
*.db-wal
*.db-shm
server/uploads/

# Expo / React Native
.expo/
mobile/.expo/
mobile/android/
mobile/ios/
*.log
_srv_install.*
_cli_install.*
.DS_Store
.vscode/
.idea/

# ── Android (Capacitor) ────────────────────────────────────────────────────
# The project itself IS committed — it holds the manifest, the icon, the
# notification sounds and the channel config, all of which are real source.
# What follows is generated or secret.
client/android/.gradle/
client/android/build/
client/android/app/build/
client/android/local.properties
client/android/.idea/
client/android/app/src/main/assets/public/
client/android/app/src/main/assets/capacitor.config.json
client/android/app/capacitor.build.gradle
client/android/capacitor.settings.gradle
client/android/capacitor-cordova-android-plugins/

# Firebase credentials for push. Contains project identifiers tied to your
# account; regenerate rather than share.
client/android/app/google-services.json

# The signing key and its passwords. Losing this means never being able to
# update an installed app; leaking it means someone else can.
*.keystore
*.jks
client/android/keystore.properties

# The built APK.
#
# `client/public/nook.apk` is the exception and IS committed, because that is
# what makes the download work. The alternative was GitHub Releases, which
# needs the repository to be public — release assets on a private repo return
# 404 to anyone not signed in, so the download button could never have worked
# while this repo stays private.
#
# The cost is a few megabytes per release in git history. The benefit is that
# publishing is a deploy: no separate hosting, no auth, and the file is served
# from the same domain as the page offering it.
*.apk
*.aab
!client/public/nook.apk

# TypeScript's incremental build cache. Pure machine state — it changes on
# every build and merges badly, and deleting it costs one slow compile.
*.tsbuildinfo
