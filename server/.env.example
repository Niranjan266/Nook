# ── Nook server ────────────────────────────────────────────────────────────────
# Copy to .env and fill what you have. Everything here has a working dev
# fallback, so the app boots and is fully usable with an empty .env.

PORT=4000
NODE_ENV=development

# Comma-separated list of frontends allowed to call this API.
# Production example: https://app.yoursite.com
CLIENT_ORIGIN=http://localhost:5173

# ── Split hosting (frontend on Vercel, API elsewhere) ──────────────────────────
# The public origin of THIS API. Used to make uploaded media URLs absolute, so
# they still resolve when the frontend is on a different domain.
#   PUBLIC_URL=https://api.yoursite.com
PUBLIC_URL=

# Where the *app* lives — the link people click in emails. Not the same as
# PUBLIC_URL: a button pointing at the API would open a JSON 404. Defaults to
# the first CLIENT_ORIGIN, which is usually right.
#   APP_URL=https://nook.yoursite.com
APP_URL=

# Set when the app and API are subdomains of one domain. The leading dot is
# required. This makes the refresh cookie first-party, which is what keeps
# people signed in on Safari and Firefox — both drop third-party cookies today.
#   COOKIE_DOMAIN=.yoursite.com
COOKIE_DOMAIN=

# Allow https://<anything>.vercel.app to call this API. Handy while you're
# testing preview deployments; turn it off once you have a real domain.
ALLOW_VERCEL_PREVIEWS=0

# ── Database ───────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/nook
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/nook
MONGODB_URI=mongodb://127.0.0.1:27017/nook

# ── Tokens ─────────────────────────────────────────────────────────────────────
# Leave blank in dev and a random secret is generated at boot (sessions reset on
# restart). Set real values before deploying.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=30d

# ── Cloudinary (media) ─────────────────────────────────────────────────────────
# Not set? Uploads are written to server/uploads and served from /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend (fallback — only used when the Gmail settings are empty) ─────────────
# RESEND_FROM must be on a domain you have verified in Resend;
# onboarding@resend.dev only delivers to the Resend account's own address.
# Never commit the real key.
RESEND_API_KEY=
RESEND_FROM=Nook <hello@niranjand.in>

# ── Brevo (transactional email — only used for optional account recovery) ──────
# Not set? Recovery codes are printed to the server console.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@nook.app
BREVO_SENDER_NAME=Nook

# ── Gmail (alternative to Brevo) ──────────────────────────────────────────────
# Gmail's HTTPS API, not SMTP: SMTP ports are blocked on many hosts including
# Render's free tier. Run `node tools/gmail-auth.mjs` to obtain these.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
GMAIL_SENDER_NAME=Nook

# auto | gmail | brevo | console
MAIL_PROVIDER=auto

# ── Sign in with Google ────────────────────────────────────────────────────────
# Redirect URI to register: <PUBLIC_URL>/api/auth/google/callback
# Empty = the button does not appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Chat backups to Google Drive ───────────────────────────────────────────────
# Uses the same Google client as sign-in. Also register the redirect URI
# <PUBLIC_URL>/api/backup/drive/callback and enable the Drive API — see
# docs/BACKUP-SETUP.md.
#
# Key that seals each person's Drive refresh token in the database. Any long
# random string (Make-Keys.bat, or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Empty = derived from JWT_REFRESH_SECRET, with a notice at boot. Changing it
# later disconnects everyone's Drive (they reconnect with one tap).
BACKUP_TOKEN_KEY=

# ── Web Push ───────────────────────────────────────────────────────────────────
# Not set? A VAPID keypair is generated at boot and printed once. Copy it here
# so push subscriptions survive restarts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@nook.app

# ── WebRTC ─────────────────────────────────────────────────────────────────────
# STUN alone fails for ~20% of users behind strict NATs. Add a TURN server for
# production. Free option: https://www.metered.ca/tools/openrelay/
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Cloudflare Realtime TURN — preferred over the static TURN above. The server
# mints 24-hour credentials and shares them, so no password ships to browsers
# for good. Dashboard → Realtime → TURN Server → Create. See docs/ENV-VARS.md.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
