# ── Nook server ────────────────────────────────────────────────────────────────
# Copy to .env and fill what you have. Everything here has a working dev
# fallback, so the app boots and is fully usable with an empty .env.

PORT=4000
NODE_ENV=development

# Comma-separated list of frontends allowed to call this API.
# Production example: https://app.yoursite.com
CLIENT_ORIGIN=http://localhost:5173

# ── Split hosting (frontend on Vercel, API elsewhere) ──────────────────────────
# The public origin of THIS API. Used to make uploaded media URLs absolute, so
# they still resolve when the frontend is on a different domain.
#   PUBLIC_URL=https://api.yoursite.com
PUBLIC_URL=

# Set when the app and API are subdomains of one domain. The leading dot is
# required. This makes the refresh cookie first-party, which is what keeps
# people signed in on Safari and Firefox — both drop third-party cookies today.
#   COOKIE_DOMAIN=.yoursite.com
COOKIE_DOMAIN=

# Allow https://<anything>.vercel.app to call this API. Handy while you're
# testing preview deployments; turn it off once you have a real domain.
ALLOW_VERCEL_PREVIEWS=0

# ── Database ───────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/nook
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/nook
MONGODB_URI=mongodb://127.0.0.1:27017/nook

# ── Tokens ─────────────────────────────────────────────────────────────────────
# Leave blank in dev and a random secret is generated at boot (sessions reset on
# restart). Set real values before deploying.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=30d

# ── Cloudinary (media) ─────────────────────────────────────────────────────────
# Not set? Uploads are written to server/uploads and served from /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Brevo (transactional email — only used for optional account recovery) ──────
# Not set? Recovery codes are printed to the server console.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@nook.app
BREVO_SENDER_NAME=Nook

# ── Web Push ───────────────────────────────────────────────────────────────────
# Not set? A VAPID keypair is generated at boot and printed once. Copy it here
# so push subscriptions survive restarts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@nook.app

# ── WebRTC ─────────────────────────────────────────────────────────────────────
# STUN alone fails for ~20% of users behind strict NATs. Add a TURN server for
# production. Free option: https://www.metered.ca/tools/openrelay/
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
