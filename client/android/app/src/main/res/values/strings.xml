<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Nook</string>
    <string name="title_activity_main">Nook</string>
    <string name="package_name">in.niranjand.nook</string>
    <!--
      The scheme Android uses to hand a link back to this app. Short and
      memorable rather than the package name, because it is what the sign-in
      redirect points at: nook://auth
    -->
    <string name="custom_url_scheme">nook</string>

    <!--
      The channel FCM falls back to when a message does not name one, or names
      one this phone lacks. It must match a channel that exists (MainActivity
      creates it), or Android quietly uses its own default and the custom sound
      never plays. v2 because MainActivity deletes the old 'messages': a push
      still aimed there, before the phone re-registers, lands here instead.
    -->
    <string name="default_notification_channel_id">messages_v2</string>
</resources>
