<?xml version="1.0" encoding="utf-8"?>
<!--
  Two pebbles leaning together — two people, one nook.

  The paths are logo.svg's own, on its 48-unit box, and the group moves them
  into place rather than every coordinate being recomputed, so the two files
  can be compared line by line:
    scale 1.45, then translate so the pair's centre (24, 25) lands on (54, 54):
    54 - 24 x 1.45 = 19.2,  54 - 25 x 1.45 = 17.75.

  The pair reaches about 18 units from its centre, so 26 here. Adaptive icons
  guarantee only the middle 72x72, and launchers that mask to a circle show a
  66 diameter — radius 33 — so the mark is never clipped whichever launcher is
  installed, with enough night around it to read as a small thing in a room.

  No shadow: VectorDrawable has no blur, and launchers add their own
  elevation to the foreground layer anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.45"
        android:scaleY="1.45"
        android:translateX="19.2"
        android:translateY="17.75">

        <!-- volt, leaning in behind -->
        <path
            android:pathData="M20,22 a11,13 0 1 0 22,0 a11,13 0 1 0 -22,0 Z"
            android:fillColor="#C8F545"
            android:fillAlpha="0.92" />

        <!-- iris, in front -->
        <path
            android:pathData="M6,26 a13,15 0 1 0 26,0 a13,15 0 1 0 -26,0 Z"
            android:fillColor="#8B7CFF" />

        <!-- eyes, in the background's night -->
        <path
            android:pathData="M14,25 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 Z M20,25 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 Z"
            android:fillColor="#0E0D14" />
    </group>
</vector>
