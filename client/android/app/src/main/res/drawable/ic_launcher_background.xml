<?xml version="1.0" encoding="utf-8"?>
<!--
  The night behind the pebbles.

  Adaptive icons are 108x108, of which only the middle 72x72 is guaranteed to
  be visible — the launcher masks the rest into whatever shape it likes, and
  shifts the two layers against each other when the icon moves. So the
  background carries no detail at all: flat night (#0E0D14, the app's dark
  background), which reads the same whether the launcher crops it to a
  circle, a squircle or a teardrop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0 h108 v108 h-108 Z"
        android:fillColor="#FF0E0D14" />
</vector>
