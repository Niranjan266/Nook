# ── Nook client ────────────────────────────────────────────────────────────────
#
# Copy to .env.local for local overrides. Vite only exposes variables prefixed
# with VITE_, and they are baked into the bundle at BUILD time — so changing one
# in the Vercel dashboard requires a redeploy, not just a save.
#
# Nothing here is secret. Anything with a VITE_ prefix is visible to anyone who
# opens devtools, so never put an API key or password in this file.

# Where the API lives. Leave EMPTY for local development — the Vite dev proxy
# forwards /api, /uploads and /socket.io to localhost:4000.
#
# In production set it to your API host, with no trailing slash:
#   VITE_API_URL=https://api.yoursite.com
VITE_API_URL=

# Only used by the dev proxy, if your local API isn't on port 4000.
VITE_API_TARGET=http://localhost:4000
