{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-audit --no-fund",

  "rewrites": [
    {
      "comment": "Single-page app: any unknown path is a route, not a missing file. The API is NOT proxied here — it lives on its own host, because Vercel cannot hold a WebSocket open.",
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "comment": "Hashed filenames, so cache them for a year.",
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "comment": "Never cache the service worker, or clients get stuck on an old one and quietly stop receiving push notifications.",
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "comment": "Nook asks for mic and camera for calls, and nothing else.",
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
